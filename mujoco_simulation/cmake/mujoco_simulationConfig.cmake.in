@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads REQUIRED)
find_dependency(OpenGL REQUIRED COMPONENTS OpenGL EGL)
find_dependency(glfw3 CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/FindMujoco.cmake")
mujoco_simulation_find_mujoco(_mujoco_simulation_mujoco_found)
if(NOT _mujoco_simulation_mujoco_found)
  set(mujoco_simulation_FOUND FALSE)
  set(mujoco_simulation_NOT_FOUND_MESSAGE
    "MuJoCo was not found. Set MUJOCO_ROOT, set the MUJOCO_ROOT environment "
    "variable, install a mujoco config package, or install it under /opt/mujoco "
    "or /opt/mujoco-3.9.0.")
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mujoco_simulationTargets.cmake")
check_required_components(mujoco_simulation)
