@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads REQUIRED)
find_dependency(OpenGL REQUIRED COMPONENTS OpenGL EGL)
find_dependency(glfw3 CONFIG REQUIRED)

set(_mujoco_simulation_mujoco_root "")
if(DEFINED ENV{MUJOCO_ROOT} AND NOT "$ENV{MUJOCO_ROOT}" STREQUAL "")
  set(_mujoco_simulation_mujoco_root "$ENV{MUJOCO_ROOT}")
else()
  set(_mujoco_simulation_mujoco_root "/opt/mujoco-3.9.0")
endif()

file(TO_CMAKE_PATH "${_mujoco_simulation_mujoco_root}"
  _mujoco_simulation_mujoco_root)
get_filename_component(_mujoco_simulation_mujoco_root
  "${_mujoco_simulation_mujoco_root}" ABSOLUTE)

if(NOT IS_DIRECTORY "${_mujoco_simulation_mujoco_root}")
  set(mujoco_simulation_FOUND FALSE)
  set(mujoco_simulation_NOT_FOUND_MESSAGE
    "MuJoCo installation directory was not found at "
    "'${_mujoco_simulation_mujoco_root}'. Set MUJOCO_ROOT or install "
    "MuJoCo under /opt/mujoco-3.9.0.")
  return()
endif()

find_path(_mujoco_simulation_mujoco_include_dir
  NAMES mujoco/mujoco.h
  PATHS "${_mujoco_simulation_mujoco_root}/include"
  NO_DEFAULT_PATH)
find_library(_mujoco_simulation_mujoco_library
  NAMES mujoco
  PATHS
    "${_mujoco_simulation_mujoco_root}/lib"
    "${_mujoco_simulation_mujoco_root}/lib64"
  NO_DEFAULT_PATH)

if(NOT _mujoco_simulation_mujoco_include_dir OR
   NOT _mujoco_simulation_mujoco_library)
  set(mujoco_simulation_FOUND FALSE)
  set(mujoco_simulation_NOT_FOUND_MESSAGE
    "MuJoCo headers or library were not found under "
    "'${_mujoco_simulation_mujoco_root}'.")
  return()
endif()

if(NOT TARGET mujoco::mujoco)
  add_library(mujoco::mujoco UNKNOWN IMPORTED)
  set_target_properties(mujoco::mujoco PROPERTIES
    IMPORTED_LOCATION "${_mujoco_simulation_mujoco_library}"
    INTERFACE_INCLUDE_DIRECTORIES "${_mujoco_simulation_mujoco_include_dir}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mujoco_simulationTargets.cmake")
check_required_components(mujoco_simulation)
