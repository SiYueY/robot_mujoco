@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads REQUIRED)
find_dependency(OpenGL REQUIRED COMPONENTS OpenGL EGL)
find_dependency(glfw3 CONFIG REQUIRED)
find_dependency(
  mujoco CONFIG REQUIRED
  PATHS "${PACKAGE_PREFIX_DIR}"
  NO_DEFAULT_PATH
)

include("${CMAKE_CURRENT_LIST_DIR}/romujocoTargets.cmake")
check_required_components(romujoco)
